# ==========================================
# Genesis - Environment Configuration Template
# ==========================================

# ------------------------------------------
# Firebase Web Client Configuration (Frontend)
# (Obtained from Firebase Console > Project Settings > General > Web Apps)
# ------------------------------------------
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=genesis-hl-builder-1.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=genesis-hl-builder-1
VITE_FIREBASE_STORAGE_BUCKET=genesis-hl-builder-1.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Use local Firebase emulators in development (true/false)
VITE_USE_EMULATORS=true

# ------------------------------------------
# HighLevel Marketplace App Configuration (Backend)
# (Obtained from marketplace.gohighlevel.com)
# ------------------------------------------
HIGHLEVEL_CLIENT_ID=your-highlevel-client-id
HIGHLEVEL_CLIENT_SECRET=your-highlevel-client-secret
HIGHLEVEL_REDIRECT_URI=http://localhost:5001/genesis-hl-builder-1/us-central1/oauthCallback
HIGHLEVEL_API_BASE_URL=https://services.leadconnectorhq.com

# ------------------------------------------
# LLM Provider Configuration (Backend)
# Compatible with Google AI Studio (Free Tier), OpenAI, or Anthropic
# ------------------------------------------
# For Google AI Studio (Free Tier):
# LLM_API_KEY=your-google-ai-studio-gemini-key
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.0-flash
#
# For OpenAI:
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.0-flash
